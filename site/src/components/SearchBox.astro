---
import { url } from '../lib/site';
---

<div class="search" data-bundle={url('pagefind/')} data-base={url()}>
  <form role="search" action={url('articles')} autocomplete="off">
    <svg class="icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <path
        fill="currentColor"
        d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"
      ></path>
    </svg>
    <input
      type="search"
      name="q"
      placeholder="Search articles"
      aria-label="Search articles"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <kbd class="hint" aria-hidden="true">/</kbd>
  </form>
  <div class="panel" id="search-results" role="listbox" hidden></div>
</div>

<script>
  // Searches the Pagefind index built by `pagefind --site dist` and lists the matches
  // under the box. The index only exists in a build, so `astro dev` says so instead.
  type Result = { url: string; excerpt: string; meta: { title?: string } };
  type Pagefind = {
    options: (o: { baseUrl: string }) => Promise<void>;
    debouncedSearch: (q: string) => Promise<{ results: { data: () => Promise<Result> }[] } | null>;
  };

  const root = document.querySelector<HTMLElement>('.search')!;
  const input = root.querySelector('input')!;
  const panel = root.querySelector<HTMLElement>('.panel')!;
  let pagefind: Promise<Pagefind | null> | undefined;
  let active = -1;

  function load() {
    pagefind ??= import(/* @vite-ignore */ `${root.dataset.bundle}pagefind.js`)
      .then(async (pf: Pagefind) => {
        await pf.options({ baseUrl: root.dataset.base! });
        return pf;
      })
      .catch(() => null);
    return pagefind;
  }

  function open(show: boolean) {
    panel.hidden = !show;
    input.setAttribute('aria-expanded', String(show));
    if (!show) setActive(-1);
  }

  function options() {
    return [...panel.querySelectorAll<HTMLAnchorElement>('[role="option"]')];
  }

  function setActive(i: number) {
    const all = options();
    active = all.length ? (i + all.length) % all.length : -1;
    all.forEach((o, j) => o.setAttribute('aria-selected', String(j === active)));
    if (active >= 0) {
      input.setAttribute('aria-activedescendant', all[active].id);
      all[active].scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  }

  function note(text: string) {
    const p = document.createElement('p');
    p.className = 'note';
    p.textContent = text;
    panel.replaceChildren(p);
    open(true);
  }

  async function search() {
    const q = input.value.trim();
    if (!q) return open(false);
    const pf = await load();
    if (!pf) return note('Search works on the built site (pnpm build && pnpm preview).');
    const found = await pf.debouncedSearch(q);
    if (found === null || q !== input.value.trim()) return; // superseded by newer input
    if (found.results.length === 0) return note(`No articles match “${q}”.`);

    const results = await Promise.all(found.results.slice(0, 8).map((r) => r.data()));
    panel.replaceChildren(
      ...results.map((r, i) => {
        const a = document.createElement('a');
        a.href = r.url;
        a.id = `search-option-${i}`;
        a.setAttribute('role', 'option');
        const title = document.createElement('span');
        title.className = 'title';
        title.textContent = r.meta.title ?? r.url;
        // Pagefind's excerpt is the page's own text, escaped, with matches in <mark>.
        const excerpt = document.createElement('span');
        excerpt.className = 'excerpt';
        excerpt.innerHTML = r.excerpt;
        a.append(title, excerpt);
        return a;
      }),
    );
    open(true);
    setActive(0);
  }

  input.addEventListener('focus', () => {
    load();
    if (input.value.trim() && panel.childElementCount) open(true);
  });
  input.addEventListener('input', search);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (panel.hidden) search();
      else setActive(active + (e.key === 'ArrowDown' ? 1 : -1));
    } else if (e.key === 'Escape') {
      if (!panel.hidden) open(false);
      else input.blur();
    }
  });
  root.querySelector('form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const target = options()[Math.max(active, 0)];
    if (target) location.href = target.href;
  });
  document.addEventListener('click', (e) => {
    if (!root.contains(e.target as Node)) open(false);
  });
  // "/" focuses the box from anywhere, as on GitHub.
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    if (target.closest('input, textarea, select, [contenteditable="true"]')) return;
    e.preventDefault();
    input.focus();
    input.select();
  });
</script>

<style>
  .search {
    position: relative;
    flex: 1 1 14rem;
    max-width: 22rem;
  }

  form {
    position: relative;
    display: flex;
    align-items: center;
  }

  .icon {
    position: absolute;
    left: 0.6rem;
    color: var(--fg-muted);
    pointer-events: none;
  }

  input {
    width: 100%;
    font: inherit;
    font-size: 0.875rem;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.3rem 2rem 0.3rem 2rem;
    line-height: 1.5;
  }

  input:focus {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
    border-color: transparent;
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  .hint {
    position: absolute;
    right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.15rem 0.35rem;
    pointer-events: none;
  }

  input:focus ~ .hint,
  input:not(:placeholder-shown) ~ .hint {
    display: none;
  }

  .panel {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    width: max(100%, min(28rem, 100vw - 32px));
    max-height: min(28rem, 70vh);
    overflow-y: auto;
    z-index: 10;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.15);
    padding: 0.35rem;
  }

  .panel :global([role='option']) {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
  }

  .panel :global([role='option'][aria-selected='true']),
  .panel :global([role='option']:hover) {
    background: var(--bg-soft);
  }

  .panel :global(.title) {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .panel :global(.excerpt) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  .panel :global(mark) {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
    border-radius: 2px;
  }

  .panel :global(.note) {
    margin: 0;
    padding: 0.5rem 0.6rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
</style>
