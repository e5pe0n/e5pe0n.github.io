---
import { groupBy, monthGrid, periodLabel } from '../lib/calendar';
import { activityUrl, url, type Article } from '../lib/site';

interface Props {
  /** `YYYY-MM` */
  month: string;
  /** The month's articles; each is placed on its date. */
  articles: Article[];
  /** Show the month's name above the grid, linking to its page. */
  heading?: boolean;
}

const { month, articles, heading = false } = Astro.props;
const byDay = new Map(groupBy(articles, (a) => a.data.date, 'day'));
const WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
---

<section class="month">
  {
    heading && (
      <h2>
        <a href={activityUrl(month)}>{periodLabel('month', month)}</a>
        <span class="muted small"> {articles.length}</span>
      </h2>
    )
  }
  <div class="month-grid" role="table" aria-label={periodLabel('month', month)}>
    <div class="row head" role="row">
      {WEEKDAYS.map((d) => <span role="columnheader">{d}</span>)}
    </div>
    {
      monthGrid(month).map((week) => {
        return (
          <div class="row" role="row">
            {week.map((day) => (
              <div class:list={['cell', { out: !day, has: day && byDay.has(day) }]} role="cell">
                {day && (
                  <>
                    <span class="date mono">
                      {byDay.has(day) ? <a href={activityUrl(day)}>{Number(day.slice(8))}</a> : Number(day.slice(8))}
                    </span>
                    {byDay.get(day)?.map((a) => (
                      <a class="post" href={url(`articles/${a.id}`)} title={a.data.title}>
                        {a.data.title}
                      </a>
                    ))}
                  </>
                )}
              </div>
            ))}
          </div>
        );
      })
    }
  </div>
</section>

<style>
  h2 {
    font-size: 1.15rem;
    margin: 2rem 0 0.5rem;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  .month-grid {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 1rem 0 2rem;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1px;
  }

  .row > * {
    background: var(--bg);
  }

  .head span {
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-align: center;
    padding: 0.25rem 0;
    background: var(--bg-soft);
  }

  .cell {
    min-height: 5.5rem;
    padding: 0.25rem 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .cell.out {
    background: var(--bg-soft);
  }

  .cell.has {
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
  }

  .date {
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  .has .date a {
    font-weight: 700;
    color: var(--accent);
  }

  .post {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
    font-size: 0.75rem;
    color: var(--fg);
    text-decoration: none;
    border-left: 2px solid var(--accent);
    padding-left: 0.3rem;
  }

  .post:hover {
    color: var(--accent);
  }

  /* Too narrow for titles: each article becomes a dot on its date. */
  @media (max-width: 560px) {
    .cell {
      min-height: 3rem;
      flex-flow: row wrap;
      align-content: flex-start;
    }

    .date {
      flex-basis: 100%;
    }

    .post {
      display: block;
      width: 0.5rem;
      height: 0.5rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--accent);
      font-size: 0;
    }
  }
</style>
