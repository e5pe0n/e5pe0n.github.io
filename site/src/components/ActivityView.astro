---
import { dayKey, groupBy, periodLabel } from '../lib/calendar';
import { activityUrl, url, type ActivityProps } from '../lib/site';
import ArticleList from './ArticleList.astro';
import MonthCalendar from './MonthCalendar.astro';
import MonthPicker from './MonthPicker.astro';

type Props = ActivityProps;

const { period, periodKey: key, articles, newer, older } = Astro.props;

const crumbs: { href: string; label: string }[] = [{ href: url('activity'), label: 'Activity' }];
if (period !== 'year') crumbs.push({ href: activityUrl(key.slice(0, 4)), label: key.slice(0, 4) });
if (period === 'day') crumbs.push({ href: activityUrl(key.slice(0, 7)), label: periodLabel('month', key.slice(0, 7)) });
---

<nav class="crumbs small" aria-label="Breadcrumb">
  {crumbs.map(({ href, label }) => <><a href={href}>{label}</a><span class="muted"> / </span></>)}
</nav>

<div class="title">
  <h1>{periodLabel(period, key)}</h1>
  {period === 'month' && <MonthPicker month={key} />}
</div>
<p class="muted">{articles.length} article{articles.length === 1 ? '' : 's'}</p>

<nav class="pager" aria-label="Adjacent periods">
  {older ? <a href={activityUrl(older)}>← {periodLabel(period, older)}</a> : <span class="disabled">← Older</span>}
  {newer ? <a href={activityUrl(newer)}>{periodLabel(period, newer)} →</a> : <span class="disabled">Newer →</span>}
</nav>

{
  period === 'year' &&
    groupBy(articles, (a) => a.data.date, 'month').map(([month, group]) => (
      <MonthCalendar month={month} articles={group} heading />
    ))
}

{
  period === 'month' && (
    <>
      <MonthCalendar month={key} articles={articles} />
      {articles.length > 0 && (
        <>
          <h2>Articles this month</h2>
          <ArticleList articles={articles} />
        </>
      )}
    </>
  )
}

{period === 'day' && <ArticleList articles={articles} />}

<p class="muted small">All dates are in JST. Today is {dayKey(new Date())} as of the last build.</p>

<style>
  .crumbs {
    margin-bottom: -0.25rem;
  }

  .title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
</style>
