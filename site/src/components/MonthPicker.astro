---
import { activityMonths, getArticles, url } from '../lib/site';

interface Props {
  /** The month shown, `YYYY-MM`. */
  month: string;
}

const { month } = Astro.props;
// Only months that have a page can be picked: from the first article's to the current one.
const months = activityMonths(await getArticles());
const years = [...new Set(months.map((m) => m.slice(0, 4)))].reverse();
const NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const [year, monthNumber] = month.split('-');
---

<form class="month-picker" data-months={months.join(',')} data-base={url('activity')} aria-label="Pick a month">
  <label>
    <span class="visually-hidden">Year</span>
    <select name="year">
      {years.map((y) => <option value={y} selected={y === year}>{y}</option>)}
    </select>
  </label>
  <label>
    <span class="visually-hidden">Month</span>
    <select name="month">
      {
        NAMES.map((name, i) => {
          const value = String(i + 1).padStart(2, '0');
          return (
            <option value={value} selected={value === monthNumber} disabled={!months.includes(`${year}-${value}`)}>
              {name}
            </option>
          );
        })
      }
    </select>
  </label>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.month-picker')) {
    const months = new Set(form.dataset.months!.split(','));
    const yearSelect = form.elements.namedItem('year') as HTMLSelectElement;
    const monthSelect = form.elements.namedItem('month') as HTMLSelectElement;

    const go = () => {
      location.href = `${form.dataset.base}/${yearSelect.value}/${monthSelect.value}`;
    };

    yearSelect.addEventListener('change', () => {
      // Keep the month if that year has it, else pick the nearest month it has.
      const options = [...monthSelect.options];
      options.forEach((o) => (o.disabled = !months.has(`${yearSelect.value}-${o.value}`)));
      if (monthSelect.selectedOptions[0]?.disabled) {
        const enabled = options.filter((o) => !o.disabled);
        const target = Number(monthSelect.value);
        enabled.sort((a, b) => Math.abs(Number(a.value) - target) - Math.abs(Number(b.value) - target));
        monthSelect.value = enabled[0].value;
      }
      go();
    });
    monthSelect.addEventListener('change', go);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      go();
    });
  }
</script>

<style>
  .month-picker {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  select {
    font: inherit;
    font-size: 0.9rem;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
