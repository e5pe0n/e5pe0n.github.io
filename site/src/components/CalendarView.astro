---
import {
  addDays,
  dayKey,
  groupBy,
  monthGrid,
  periodKey,
  periodLabel,
  periodRange,
} from '../lib/calendar';
import { calendarUrl, url, type CalendarProps } from '../lib/site';
import ArticleList from './ArticleList.astro';
import Heatmap from './Heatmap.astro';

type Props = CalendarProps;

const { period, periodKey: key, articles, newer, older } = Astro.props;
const byDay = new Map(groupBy(articles, (a) => a.data.date, 'day'));
const counts = new Map([...byDay].map(([day, group]) => [day, group.length]));
const { from } = periodRange(period, key);

// Breadcrumbs up to the year; a week sits under the year of its Monday.
const crumbs: { href: string; label: string }[] = [{ href: url('calendar'), label: 'Calendar' }];
if (period !== 'year') crumbs.push({ href: calendarUrl('year', from.slice(0, 4)), label: from.slice(0, 4) });
if (period === 'day') crumbs.push({ href: calendarUrl('month', key.slice(0, 7)), label: periodLabel('month', key.slice(0, 7)) });

const weekDays = period === 'week' ? Array.from({ length: 7 }, (_, i) => addDays(from, i)) : [];
const WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
---

<nav class="crumbs small" aria-label="Breadcrumb">
  {crumbs.map(({ href, label }) => <><a href={href}>{label}</a><span class="muted"> / </span></>)}
</nav>
<h1>{periodLabel(period, key)}</h1>
<p class="muted">{articles.length} article{articles.length === 1 ? '' : 's'}</p>

<nav class="pager" aria-label="Adjacent periods">
  {older ? <a href={calendarUrl(period, older)}>← {periodLabel(period, older)}</a> : <span class="disabled">← Older</span>}
  {newer ? <a href={calendarUrl(period, newer)}>{periodLabel(period, newer)} →</a> : <span class="disabled">Newer →</span>}
</nav>

{
  period === 'year' && (
    <>
      <Heatmap year={key} counts={counts} />
      {groupBy(articles, (a) => a.data.date, 'month').map(([month, group]) => (
        <section>
          <h2>
            <a href={calendarUrl('month', month)}>{periodLabel('month', month)}</a>
          </h2>
          <ArticleList articles={group} />
        </section>
      ))}
    </>
  )
}

{
  period === 'month' && (
    <>
      <div class="month-grid" role="table" aria-label={periodLabel('month', key)}>
        <div class="row head" role="row">
          <span role="columnheader">Week</span>
          {WEEKDAYS.map((d) => <span role="columnheader">{d}</span>)}
        </div>
        {monthGrid(key).map((week) => {
          const firstDay = week.find(Boolean)!;
          const weekKey = periodKey('week', firstDay);
          const weekHasPosts = week.some((d) => d && byDay.has(d));
          return (
            <div class="row" role="row">
              <span class="week mono small" role="cell">
                {weekHasPosts ? <a href={calendarUrl('week', weekKey)}>{weekKey.slice(5)}</a> : weekKey.slice(5)}
              </span>
              {week.map((day) => (
                <div class:list={['cell', { out: !day, has: day && byDay.has(day) }]} role="cell">
                  {day && (
                    <>
                      <span class="date mono">
                        {byDay.has(day) ? <a href={calendarUrl('day', day)}>{Number(day.slice(8))}</a> : Number(day.slice(8))}
                      </span>
                      {byDay.get(day)?.map((a) => (
                        <a class="post small" href={url(`articles/${a.id}`)}>{a.data.title}</a>
                      ))}
                    </>
                  )}
                </div>
              ))}
            </div>
          );
        })}
      </div>
      <h2>All articles this month</h2>
      <ArticleList articles={articles} />
    </>
  )
}

{
  period === 'week' && (
    <ol class="week-days">
      {weekDays.map((day) => (
        <li>
          <h2 class="small mono">
            {byDay.has(day) ? <a href={calendarUrl('day', day)}>{periodLabel('day', day)}</a> : <span class="muted">{periodLabel('day', day)}</span>}
          </h2>
          {byDay.has(day) && <ArticleList articles={byDay.get(day)!} />}
        </li>
      ))}
    </ol>
  )
}

{
  period === 'day' && (
    <>
      <p class="small">
        <a href={calendarUrl('week', periodKey('week', key))}>Week {periodKey('week', key).slice(6)}</a>
      </p>
      <ArticleList articles={articles} />
    </>
  )
}

<p class="muted small">All dates are in JST. Today is {dayKey(new Date())} as of the last build.</p>

<style>
  .crumbs {
    margin-bottom: -0.25rem;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  .month-grid {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 1rem 0 2rem;
  }

  .row {
    display: grid;
    grid-template-columns: 2.6rem repeat(7, minmax(0, 1fr));
    gap: 1px;
  }

  .row > * {
    background: var(--bg);
  }

  .head span {
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-align: center;
    padding: 0.25rem 0;
    background: var(--bg-soft);
  }

  .week {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 0.35rem;
    background: var(--bg-soft);
  }

  .cell {
    min-height: 5.5rem;
    padding: 0.25rem 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .cell.out {
    background: var(--bg-soft);
  }

  .cell.has {
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
  }

  .date {
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  .has .date a {
    font-weight: 700;
    color: var(--accent);
  }

  .post {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
    font-size: 0.75rem;
    color: var(--fg);
    text-decoration: none;
    border-left: 2px solid var(--accent);
    padding-left: 0.3rem;
  }

  @media (max-width: 560px) {
    .cell {
      min-height: 3rem;
    }

    .post {
      display: none;
    }

    .row {
      grid-template-columns: 2.2rem repeat(7, minmax(0, 1fr));
    }
  }

  .week-days {
    list-style: none;
    padding: 0;
  }

  .week-days > li {
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    margin-bottom: 0.5rem;
  }

  .week-days h2 {
    margin: 0.75rem 0 0.25rem;
    font-weight: 600;
  }
</style>
