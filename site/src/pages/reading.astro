---
import ProfileLayout from '../layouts/ProfileLayout.astro';
import { PERIODS } from '../lib/calendar';

const LABELS = { day: 'Day', week: 'Week', month: 'Month', year: 'Year' } as const;
---

<ProfileLayout title="Reading" description="What I've been reading lately, live from my RSS reader.">
  <p class="muted intro">
    What I've read in <a href="https://github.com/e5pe0n/shushu">shushu</a>, my RSS reader, live. Times are in JST.
  </p>

  <div class="controls">
    <div class="segmented" role="group" aria-label="Period">
      {
        PERIODS.map((p) => (
          <button type="button" data-period={p} aria-pressed="false">
            {LABELS[p]}
          </button>
        ))
      }
    </div>
    <button type="button" id="today" class="link-button small">Today</button>
  </div>

  <nav class="pager" aria-label="Adjacent periods">
    <button type="button" id="prev">← Older</button>
    <strong id="label" aria-live="polite"></strong>
    <button type="button" id="next">Newer →</button>
  </nav>

  <p id="summary" class="muted small"></p>
  <div id="heatmap" class="heatmap" hidden></div>
  <div id="results" aria-busy="true">
    <p class="empty-state">Loading…</p>
  </div>
  <noscript><p class="empty-state">The reading log is loaded live and needs JavaScript.</p></noscript>
</ProfileLayout>

<script>
  import {
    dayKey,
    groupBy,
    PERIODS,
    periodKey,
    periodLabel,
    periodRange,
    shiftPeriod,
    yearGrid,
    type Period,
  } from '../lib/calendar';
  import { fetchReads, readItem, type Read } from '../lib/reads';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const results = $('results');
  const heatmap = $('heatmap');
  const prev = $<HTMLButtonElement>('prev');
  const next = $<HTMLButtonElement>('next');
  const label = $('label');
  const summary = $('summary');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.controls [data-period]');

  const today = () => dayKey(new Date());
  let period: Period = 'week';
  let key = periodKey(period, today());
  let controller: AbortController | undefined;

  function readState() {
    const params = new URLSearchParams(location.search);
    const p = params.get('period') as Period | null;
    if (p && PERIODS.includes(p)) period = p;
    const k = params.get('key');
    key = k && k <= periodKey(period, today()) ? periodKey(period, periodRange(period, k).from) : periodKey(period, today());
  }

  function writeState() {
    const params = new URLSearchParams({ period, key });
    history.replaceState(null, '', `?${params}`);
  }

  function message(text: string) {
    const p = document.createElement('p');
    p.className = 'empty-state';
    p.textContent = text;
    results.replaceChildren(p);
  }

  function list(reads: Read[], showDay = false) {
    const ul = document.createElement('ul');
    ul.className = 'entries';
    ul.append(...reads.map((r) => readItem(r, { showDay })));
    return ul;
  }

  /** Sections of reads grouped by `by`, each headed by a link that drills into that period. */
  function grouped(reads: Read[], by: Period) {
    const frag = document.createDocumentFragment();
    for (const [k, group] of groupBy(reads, (r) => new Date(r.read_at), by)) {
      const h = document.createElement('h2');
      h.className = 'group-heading';
      const a = document.createElement('a');
      a.href = `?${new URLSearchParams({ period: by, key: k })}`;
      a.textContent = periodLabel(by, k);
      a.addEventListener('click', (e) => {
        e.preventDefault();
        go(by, k);
      });
      const count = document.createElement('span');
      count.className = 'muted small';
      count.textContent = ` ${group.length}`;
      h.append(a, count);
      frag.append(h, by === 'month' ? monthSummary(group) : list(group));
    }
    return frag;
  }

  /** For a year view: per month, just the count and the feeds read most. */
  function monthSummary(reads: Read[]) {
    const feeds = new Map<string, number>();
    for (const r of reads) feeds.set(r.feed_title, (feeds.get(r.feed_title) ?? 0) + 1);
    const top = [...feeds].sort((a, b) => b[1] - a[1]).slice(0, 5);
    const p = document.createElement('p');
    p.className = 'muted small';
    p.textContent = top.map(([f, n]) => `${f} (${n})`).join(' · ');
    return p;
  }

  function renderHeatmap(reads: Read[]) {
    const counts = new Map<string, number>();
    for (const r of reads) {
      const d = dayKey(new Date(r.read_at));
      counts.set(d, (counts.get(d) ?? 0) + 1);
    }
    const max = Math.max(1, ...counts.values());
    const grid = document.createElement('div');
    grid.className = 'heatmap-grid';
    for (const column of yearGrid(key)) {
      for (const day of column) {
        const n = day ? (counts.get(day) ?? 0) : 0;
        const cell = document.createElement(n > 0 ? 'a' : 'span');
        cell.className = day ? 'heatmap-cell' : 'heatmap-cell empty';
        if (day) {
          cell.dataset.level = String(n === 0 ? 0 : Math.ceil((n / max) * 4));
          cell.title = `${day}: ${n} read${n === 1 ? '' : 's'}`;
        }
        if (day && n > 0) {
          (cell as HTMLAnchorElement).href = `?${new URLSearchParams({ period: 'day', key: day })}`;
          cell.addEventListener('click', (e) => {
            e.preventDefault();
            go('day', day);
          });
        }
        grid.append(cell);
      }
    }
    heatmap.replaceChildren(grid);
    heatmap.hidden = false;
  }

  async function load() {
    controller?.abort();
    controller = new AbortController();
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.period === period)));
    label.textContent = periodLabel(period, key);
    next.disabled = key >= periodKey(period, today());
    heatmap.hidden = true;
    summary.textContent = '';
    results.setAttribute('aria-busy', 'true');
    message('Loading…');

    const { from, to } = periodRange(period, key);
    let reads: Read[];
    try {
      reads = await fetchReads(from, to, controller.signal);
    } catch (e) {
      if ((e as Error).name === 'AbortError') return;
      results.setAttribute('aria-busy', 'false');
      message('The reading log is unavailable right now. Try again later.');
      return;
    }
    results.setAttribute('aria-busy', 'false');
    summary.textContent = `${reads.length} item${reads.length === 1 ? '' : 's'} read`;
    if (reads.length === 0 && period !== 'year') {
      message('Nothing read in this period.');
      return;
    }
    results.replaceChildren();
    switch (period) {
      case 'day':
        results.append(list(reads));
        break;
      case 'week':
      case 'month':
        results.append(grouped(reads, 'day'));
        break;
      case 'year':
        renderHeatmap(reads);
        results.append(grouped(reads, 'month'));
        break;
    }
  }

  function go(p: Period, k: string) {
    period = p;
    key = periodKey(p, periodRange(p, k).from);
    writeState();
    load();
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const p = b.dataset.period as Period;
      // Keep looking at the same moment: the period containing the start of the current one,
      // or today if that is in the current period.
      const { from, to } = periodRange(period, key);
      const anchor = today() >= from && today() <= to ? today() : from;
      go(p, periodKey(p, anchor));
    }),
  );
  prev.addEventListener('click', () => go(period, shiftPeriod(period, key, -1)));
  next.addEventListener('click', () => go(period, shiftPeriod(period, key, 1)));
  $('today').addEventListener('click', () => go(period, periodKey(period, today())));

  readState();
  load();
</script>

<style>
  .intro {
    margin-top: 0;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .link-button {
    background: none;
    border: 0;
    color: var(--link);
    cursor: pointer;
    font: inherit;
    padding: 0;
  }

  #label {
    text-align: center;
  }

  #heatmap {
    margin-bottom: 1rem;
  }

  :global(.group-heading) {
    font-size: 1rem;
    margin: 1.5rem 0 0;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--border);
  }

  :global(.group-heading a) {
    color: inherit;
    text-decoration: none;
  }

  :global(.group-heading a:hover) {
    color: var(--accent);
  }
</style>
