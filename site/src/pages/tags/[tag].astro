---
import ArticleList from '../../components/ArticleList.astro';
import Base from '../../layouts/Base.astro';
import { getArticles, tagCounts, url, type Article } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return tagCounts(articles).map(([tag]) => ({
    params: { tag },
    props: { tag, articles: articles.filter((a) => a.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  articles: Article[];
}

const { tag, articles } = Astro.props;
---

<Base title={`#${tag}`}>
  <p class="small"><a href={url('tags')}>← All tags</a></p>
  <h1 class="mono">#{tag}</h1>
  <p class="muted">{articles.length} article{articles.length === 1 ? '' : 's'}</p>
  <ArticleList articles={articles} />
</Base>
