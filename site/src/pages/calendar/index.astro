---
import ArticleList from '../../components/ArticleList.astro';
import Heatmap from '../../components/Heatmap.astro';
import Base from '../../layouts/Base.astro';
import { groupBy, periodLabel, PERIODS } from '../../lib/calendar';
import { calendarUrl, getArticles } from '../../lib/site';

const articles = await getArticles();
const counts = new Map(groupBy(articles, (a) => a.data.date, 'day').map(([day, group]) => [day, group.length]));
const years = groupBy(articles, (a) => a.data.date, 'year');
const LABELS = { day: 'Day', week: 'Week', month: 'Month', year: 'Year' } as const;
---

<Base title="Calendar">
  <h1>Calendar</h1>
  <p class="muted">Articles by when they were written. Dates are in JST.</p>

  {
    years.length === 0 && <p class="empty-state">No articles yet.</p>
  }

  {
    years.map(([year, group]) => (
      <section class="year">
        <h2>
          <a href={calendarUrl('year', year)}>{year}</a>
          <span class="muted small"> {group.length} articles</span>
        </h2>
        <Heatmap year={year} counts={counts} />
      </section>
    ))
  }

  <div class="group-by">
    <span class="muted small">Group by</span>
    <div class="segmented" role="group" aria-label="Group articles by">
      {PERIODS.map((p) => (
        <button type="button" data-period={p} aria-pressed={p === 'month' ? 'true' : 'false'}>
          {LABELS[p]}
        </button>
      ))}
    </div>
  </div>

  {
    PERIODS.map((p) => (
      <div class="grouping" data-period={p} hidden={p !== 'month'}>
        {groupBy(articles, (a) => a.data.date, p).map(([key, group]) => (
          <section>
            <h3>
              <a href={calendarUrl(p, key)}>{periodLabel(p, key)}</a>
              <span class="muted small"> {group.length}</span>
            </h3>
            <ArticleList articles={group} />
          </section>
        ))}
      </div>
    ))
  }
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.group-by button');
  const groupings = document.querySelectorAll<HTMLElement>('.grouping');

  function show(period: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.period === period)));
    groupings.forEach((g) => (g.hidden = g.dataset.period !== period));
    try {
      localStorage.setItem('calendar-group-by', period);
    } catch {}
  }

  buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.period!)));
  try {
    const saved = localStorage.getItem('calendar-group-by');
    if (saved) show(saved);
  } catch {}
</script>

<style>
  .year h2 a,
  h3 a {
    color: inherit;
    text-decoration: none;
  }

  .year h2 a:hover,
  h3 a:hover {
    color: var(--accent);
  }

  .group-by {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 2.5rem 0 0.5rem;
    flex-wrap: wrap;
  }

  h3 {
    margin: 1.5rem 0 0;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.25rem;
  }
</style>
