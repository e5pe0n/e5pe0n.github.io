---
import ActivityView from '../../../../components/ActivityView.astro';
import Base from '../../../../layouts/Base.astro';
import { periodLabel } from '../../../../lib/calendar';
import { activityPaths, type ActivityProps } from '../../../../lib/site';

export const getStaticPaths = () => activityPaths('day');

type Props = ActivityProps;
---

<Base title={periodLabel(Astro.props.period, Astro.props.periodKey)}>
  <ActivityView {...Astro.props} />
</Base>
